poly-drill/
├─ backend/
│  ├─ server.js          # Express 服务入口
│  ├─ database.js        # SQLite 初始化与封装
│  ├─ routes.js          # API 路由 (登录、提交答案、获取数据)
│  └─ core/
│     └─ mathEngine.js   # 基于 mathjs/Algebrite 封装的判卷与出题逻辑
├─ frontend/
│  ├─ index.html         # 登录/注册页
│  ├─ practice.html      # 学生答题页 (引入 KaTeX)
│  ├─ dashboard.html     # 老师看板
│  ├─ css/
│  │  └─ style.css       
│  └─ js/
│     ├─ practice.js     # 软键盘交互、请求出题与判卷
│     └─ dashboard.js    # 图表与数据渲染
├─ data/
│  └─ poly.db            # SQLite 数据库文件 (运行时自动生成)
├─ package.json          # 依赖管理
└─ start.cmd             # 启动脚本